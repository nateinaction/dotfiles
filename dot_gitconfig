[core]
	excludesFile = ~/.gitignore
	editor = /usr/bin/vim
[commit]
	template = ~/.stCommitMsg
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	program = gpg
[pull]
	rebase = false
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local

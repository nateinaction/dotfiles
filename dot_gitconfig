[core]
	excludesFile = ~/.gitignore
	editor = ~/.nix-profile/bin/hx
[commit]
	template = ~/.stCommitMsg
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[gpg]
	program = gpg
[pull]
	rebase = false
[init]
	defaultBranch = main
[include]
	path = ~/.gitconfig.local
[url "git@github.com:"]
	insteadof = https://github.com/

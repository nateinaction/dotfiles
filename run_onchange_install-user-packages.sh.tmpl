#!/usr/bin/env bash
#
# Reconstitute my user-scoped CLI tools (gh, claude-code) into the Nix profile.
#
# These tools are user state, not part of the stableOS image: they live in
# ~/.config/user-packages/flake.nix and are installed into my per-user Nix
# profile. Keeping them here means a fresh machine gets them from the same
# `chezmoi apply` that lays down the rest of my dotfiles.
#
# chezmoi re-runs this script whenever the flake changes (content hashes below):
#   flake.nix:  {{ include "dot_config/user-packages/flake.nix" | sha256sum }}
#   flake.lock: {{ include "dot_config/user-packages/flake.lock" | sha256sum }}

set -euo pipefail

flake="${HOME}/.config/user-packages"

# Nix is provided by the stableOS image (socket-activated daemon). If it is not
# on PATH yet, skip rather than failing the whole apply.
if ! command -v nix >/dev/null 2>&1; then
  echo "nix not found on PATH; skipping user-packages profile install" >&2
  exit 0
fi

# `nix profile` and flake refs need these experimental features. Pass them
# explicitly so this works regardless of whether the machine's nix.conf
# enables them (e.g. a stock Nix install on macOS).
nix() {
  command nix --extra-experimental-features "nix-command flakes" "$@"
}

# Idempotent: upgrade the "user-cli-tools" profile entry in place if it already
# exists, otherwise add it (first run / fresh machine).
if nix profile list | sed 's/\x1b\[[0-9;]*m//g' | grep -q 'user-cli-tools'; then
  nix profile upgrade user-cli-tools
else
  nix profile add "${flake}#user-cli-tools"
fi

# Fonts installed into the Nix profile live under ~/.nix-profile/share/fonts,
# which desktop apps (terminals, launched outside a Nix shell) don't search.
# Link them into the per-user font directory the OS's apps do search, so the
# Nerd Font is selectable in terminal preferences.
nix_fonts="${HOME}/.nix-profile/share/fonts/truetype/NerdFonts/JetBrainsMono"
if [ -d "${nix_fonts}" ]; then
  if [ "$(uname -s)" = "Darwin" ]; then
    # macOS apps (Terminal.app, iTerm2) search ~/Library/Fonts; no fc-cache.
    mkdir -p "${HOME}/Library/Fonts"
    ln -sfn "${nix_fonts}" "${HOME}/Library/Fonts/JetBrainsMonoNerdFont"
  else
    # Linux/XDG apps search ~/.local/share/fonts; refresh the fontconfig cache.
    mkdir -p "${HOME}/.local/share/fonts"
    ln -sfn "${nix_fonts}" "${HOME}/.local/share/fonts/JetBrainsMonoNerdFont"
    command -v fc-cache >/dev/null 2>&1 && fc-cache -f "${HOME}/.local/share/fonts" >/dev/null 2>&1 || true
  fi
fi

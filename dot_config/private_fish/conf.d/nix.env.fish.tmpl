{{- if eq .chezmoi.os "darwin" -}}
# Nix (multi-user daemon install) — macOS only
#
# On macOS, path_helper (/etc/paths.d) only exposes the default profile, and the
# nix-daemon profile script is only wired into bash — fish never picks up the
# per-user profile. So put my `user-cli-tools` (hx, starship, zoxide, op, gh,
# go, …) on PATH here. On Linux the base image already wires nix into fish, so
# this file is rendered empty (and thus omitted) off macOS.
#
# Must load before the starship/zoxide/op snippets that invoke those binaries;
# "nix" sorts before them, so conf.d's alphabetical load order handles that.
#
# Source Nix's own fish integration first for NIX_PROFILES / NIX_SSL_CERT_FILE /
# XDG_DATA_DIRS (it has a re-entry guard, so it's a no-op where nix is already
# set up). It relies on `fish_add_path --global`, which on fish 4.x updates
# fish_user_paths but not $PATH in a fresh shell, so prepend the profile bins to
# PATH explicitly afterwards.
if test -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.fish
    source /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.fish

    for nix_bin in $HOME/.nix-profile/bin /nix/var/nix/profiles/default/bin
        if test -d $nix_bin; and not contains $nix_bin $PATH
            set -gx PATH $nix_bin $PATH
        end
    end
end
{{- end -}}

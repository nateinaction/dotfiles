{
  "$schema": "https://opencode.ai/config.json",
  // The global directives live in one file, shared with Claude Code. Naming it
  // here rather than copying it into a global AGENTS.md keeps a single source of
  // truth: opencode picks one global rules file, so a global AGENTS.md would
  // shadow this rather than merge with it. The path is rendered absolute because
  // a relative path in a global config resolves against the run's directory.
  "instructions": ["{{ .chezmoi.homeDir }}/.claude/CLAUDE.md"],
  "plugins": [
    {
      "package": "github:nateinaction/opencode-plugin-auto-classifier",
      "options": {
{{- if .work }}
        // Work machine: the classifier runs locally on Ollama
        // (`ollama pull pplx-decider-flash`, needs `ollama serve`), through its
        // System One endpoint. `provider` only picks defaults, so the explicit
        // endpoint and model win; the dummy apiKey stops the OpenRouter key
        // being sent to localhost. See nateinaction/dotfiles#62.
        "provider": "openrouter",
        "endpoint": "http://localhost:11434/v1/systemone",
        "model": "pplx-decider-flash",
        "apiKey": "ollama",
        // A cold model load can exceed the 10s default.
        "timeoutMs": 30000,
        "mode": "auto-mode",
        "debug": true,
        // Decide uncertain verdicts from the facts ("tiered"), not from the
        // classifier's own answers. In an eval of 110 cases pplx-decider-flash
        // passed 104 under tiered, failing only toward denial; "accept" would
        // have allowed key exfiltration over DNS and `git clean -fdx`.
        "onUncertain": "tiered",
        // Local fallback for when the classifier fails. With "tiered" it is not
        // asked about uncertain verdicts, only when the classifier call errors.
        "fallbackModel": "ollama/inkling-2-mini:latest"
{{- else }}
        "provider": "openrouter",
        "mode": "auto-mode",
        "debug": true,
        // Act on Jev's own answers when it is uncertain, rather than asking the
        // fallback model: sampled repeatedly, the fallback flipped borderline
        // actions between allow and deny and took 4-60s per call.
        "onUncertain": "accept",
        "fallbackModel": "openrouter/~deepseek/deepseek-flash-latest"
{{- end }}
      }
    }
  ],
  // Cost controls for OpenRouter traffic.
  //
  // Response caching: identical requests (agent retries, re-runs, repeated
  // commands) are served from OpenRouter's edge cache with zero tokens billed.
  // The first request bills normally; every identical repeat within the TTL is
  // free and returns in ~80-300 ms. Override the 5-minute default with
  // "X-OpenRouter-Cache-TTL" (1-86400 seconds).
  // https://openrouter.ai/docs/guides/features/response-caching
  //
  // Prompt caching and provider sticky routing need no configuration here:
  // OpenCode already sends provider-side cache_control breakpoints and a
  // per-session prompt_cache_key, which OpenRouter uses as its sticky routing
  // key, keeping cache reads on the provider that holds the warm cache.
  // https://openrouter.ai/docs/features/prompt-caching#provider-sticky-routing
  "providers": {
    "openrouter": {
      "headers": {
        "X-OpenRouter-Cache": "true"
      }
    }
  }
}
